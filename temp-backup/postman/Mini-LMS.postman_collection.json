{
  "info": {
    "name": "Mini LMS - Submission File Service",
    "description": "Endpoint service Submission File. Untuk POST gunakan Auth/Assignment/Notification yang sesuai adapter atau lingkungan mock lokal; koleksi ini tidak membuktikan integrasi eksternal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:8105"},
    {"key": "token", "value": "replace-with-valid-token"},
    {"key": "assignment_id", "value": "replace-with-assignment-id"},
    {"key": "submission_id", "value": "replace-after-upload"}
  ],
  "item": [
    {"name": "Health check (no token)", "request": {"method": "GET", "url": "{{base_url}}/health"}},
    {"name": "List by assignment", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "X-Request-ID", "value": "postman-list-001"}], "url": "{{base_url}}/api/submissions?assignment_id={{assignment_id}}"}},
    {"name": "Upload valid submission (select allowed file)", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "X-Request-ID", "value": "postman-upload-001"}], "body": {"mode": "formdata", "formdata": [{"key": "assignment_id", "value": "{{assignment_id}}", "type": "text"}, {"key": "file", "type": "file", "src": ""}]}, "url": "{{base_url}}/api/submissions"}, "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 201) {", "  pm.collectionVariables.set('submission_id', pm.response.json().data.submission.id);", "}"]}}]},
    {"name": "Upload empty file (expect 400)", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "formdata", "formdata": [{"key": "assignment_id", "value": "{{assignment_id}}", "type": "text"}, {"key": "file", "type": "file", "src": ""}]}, "url": "{{base_url}}/api/submissions", "description": "Choose a zero-byte file in the file picker."}},
    {"name": "Upload unsupported extension (expect 415)", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "formdata", "formdata": [{"key": "assignment_id", "value": "{{assignment_id}}", "type": "text"}, {"key": "file", "type": "file", "src": ""}]}, "url": "{{base_url}}/api/submissions", "description": "Select a non-allowlisted extension, for example .exe."}},
    {"name": "Upload MIME mismatch (expect 415)", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "formdata", "formdata": [{"key": "assignment_id", "value": "{{assignment_id}}", "type": "text"}, {"key": "file", "type": "file", "src": "", "contentType": "application/pdf"}]}, "url": "{{base_url}}/api/submissions", "description": "Use a .txt file but set the multipart file Content-Type to application/pdf."}},
    {"name": "Upload oversized file (expect 413)", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "body": {"mode": "formdata", "formdata": [{"key": "assignment_id", "value": "{{assignment_id}}", "type": "text"}, {"key": "file", "type": "file", "src": ""}]}, "url": "{{base_url}}/api/submissions", "description": "Select a file larger than MAX_UPLOAD_BYTES in .env."}},
    {"name": "Delete submission", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "X-Request-ID", "value": "postman-delete-001"}], "url": "{{base_url}}/api/submissions/{{submission_id}}"}},
    {"name": "Delete missing submission (expect 404)", "request": {"method": "DELETE", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{base_url}}/api/submissions/replace-with-nonexistent-id"}},
    {"name": "List without token (expect 401)", "request": {"method": "GET", "url": "{{base_url}}/api/submissions?assignment_id={{assignment_id}}"}}
  ]
}
