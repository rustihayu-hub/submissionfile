SERVICE_NAME=submission-file-service
HOST=127.0.0.1
PORT=8105
API_PREFIX=/api/submissions
DATABASE_PATH=./storage/submissions.db
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.txt,.zip,.png,.jpg,.jpeg
# Optional MIME allowlist. Empty uses a built-in extension-to-MIME map.
ALLOWED_MIME_TYPES=
DEPENDENCY_TIMEOUT_SECONDS=3.0
AUTH_SERVICE_URL=http://127.0.0.1:8102
# Authentication Service contract: GET /api/v1/auth/me.
AUTH_VALIDATE_PATH=/api/v1/auth/me
AUTH_TOKEN_HEADER=Authorization
ASSIGNMENT_SERVICE_URL=http://127.0.0.1:8104
ASSIGNMENT_VALIDATE_PATH=/api/assignments/{assignment_id}
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8106
# Notification Service contract: POST /api/notifications.
NOTIFICATION_SUBMISSION_PATH=/api/notifications
